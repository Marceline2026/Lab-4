pirate = {"Hello":"Avast",
          "Excuse":"Arrr",
          "Sir":"Matey",
          "Boy":"Matey",
          "Man":"Matey",
          "Madam":"Proud Beauty",
          "Woman":"Proud Beauty",
          "The":"Th'",
          "My":"Me",
          "Your":"Yer",
          "Is":"Be",
          "Are":"Be",
          "Kitchen":"Galley",
          "Hotel":"Fleabag inn"}

sentence = input("Enter a sentence: ")#input
words = sentence.split()#breaks up the sentence
new_words = [] #the list of the input words
for word in words:
    punctuation = ""
    while word and word[-1] in ".,!?":
        punctuation = word[-1] + punctuation #this chuck save the punctuation if there is any
        word = word[:-1]
    replacement = pirate.get(word.capitalize(), word)
    if word and word[0].isupper():
        replacement = replacement.capitalize()     #this chunk find the word in the dictionary and checks if its in the listand dictioanry adn replaces the key with the value
    new_words.append(replacement + punctuation) #adds back the punctuation
pirate_sentence = " ".join(new_words) #puts it back as a sentence
    

print(pirate_sentence)

